{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/indian-constitution-temporal-qa/benchmark.schema.json",
  "title": "Indian Constitution Temporal QA Benchmark",
  "type": "object",
  "required": [
    "benchmark_id",
    "planning_goal",
    "systems",
    "corpus_provenance",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "planning_goal": {
      "type": "integer",
      "minimum": 1
    },
    "systems": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "corpus_provenance": {
      "type": "object",
      "required": [
        "index_path",
        "corpus_snapshot",
        "corpus_snapshot_source",
        "chunk_count",
        "embedding_model"
      ],
      "additionalProperties": false,
      "properties": {
        "index_path": {
          "type": "string",
          "minLength": 1
        },
        "corpus_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpus_snapshot_source": {
          "type": "string",
          "minLength": 1
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1
        },
        "embedding_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "source_reference_id",
        "evidence_text",
        "chunk_id",
        "version_id",
        "verification_status"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_text": {
          "type": "string",
          "minLength": 1
        },
        "chunk_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "partially_verified",
            "pending_verification"
          ]
        }
      }
    },
    "source_reference": {
      "type": "object",
      "required": [
        "reference_id",
        "source_type",
        "source_document",
        "source_locator",
        "verification_status",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "primary_source",
            "indexed_primary_source",
            "canonical_pilot",
            "verified_canonical_record"
          ]
        },
        "source_document": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "verified",
            "partially_verified",
            "pending_verification"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "question_id",
        "question",
        "reference_date",
        "question_category",
        "target_articles",
        "expected_answer",
        "gold_evidence",
        "expected_version_id",
        "expected_temporal_status",
        "difficulty",
        "verification_status",
        "evaluation_status",
        "source_references"
      ],
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^Q[0-9]{3,}$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        },
        "question_category": {
          "enum": [
            "direct_article_lookup",
            "constitutional_interpretation",
            "amendment_related",
            "historical_version",
            "effective_date",
            "multi_article"
          ]
        },
        "target_articles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}[A-Z]?$"
          }
        },
        "expected_answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "gold_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "expected_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_temporal_status": {
          "enum": [
            "current_snapshot",
            "act_text",
            "act_date_only",
            "notification_date",
            "gazette_publication_date",
            "commencement_date",
            "historical_version_pending_verification",
            "verified_historical_version",
            "evidence_coverage_exceeded"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "pending_source_verification"
          ]
        },
        "evaluation_status": {
          "enum": [
            "suitable_for_evaluation",
            "pending_source_verification"
          ]
        },
        "source_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_reference"
          }
        },
        "expected_key_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evaluation_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
